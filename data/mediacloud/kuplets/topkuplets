import csv
import os
from collections import Counter
from itertools import islice

import spacy
import matplotlib.pyplot as plt
import numpy as np

nlp = spacy.load("fr_core_news_sm")

INPUT_DIR  = "/Users/r/Documents/CS/projet_S8/data/google_trends/2703/"
OUTPUT_DIR = "/Users/r/Documents/CS/projet_S8/data/google_trends/2703/plots/"
os.makedirs(OUTPUT_DIR, exist_ok=True)

CAMPAIGN_FILES = {
    "Dry January":  "articles_dry_january_scraped.csv",
    "Mars Bleu":    "articles_mars_bleu_scraped.csv",
    "Movember":     "articles_movember_scraped.csv",
    "Octobre Rose": "articles_octobre_rose_scraped.csv",
}

CAMPAIGN_COLORS = {
    "Dry January":  "#2196F3",
    "Mars Bleu":    "#1565C0",
    "Movember":     "#5D4037",
    "Octobre Rose": "#E91E8C",
}

TOP_N    = 15
STOP_POS = {"PUNCT", "SPACE", "NUM", "SYM", "X"}


def is_valid_token(token):
    return (
        not token.is_stop
        and not token.is_punct
        and not token.is_space
        and token.pos_ not in STOP_POS
        and len(token.lemma_) > 2
    )


def extract_ngrams(tokens, n):
    return zip(*[islice(tokens, i, None) for i in range(n)])


def get_tokens(full_text, chunk_size=100_000):
    tokens = []
    for i in range(0, len(full_text), chunk_size):
        doc = nlp(full_text[i:i + chunk_size])
        tokens.extend(
            token.lemma_.lower()
            for token in doc
            if is_valid_token(token)
        )
    return tokens


def plot_campaign(campaign, top_ngrams_by_k, color):
    fig, axes = plt.subplots(1, 3, figsize=(22, 8))
    fig.patch.set_facecolor("white")

    k_labels = {2: "Bigrammes", 3: "Trigrammes", 4: "4-grammes"}
    base_rgb  = np.array(plt.matplotlib.colors.to_rgb(color))

    for ax, k in zip(axes, (2, 3, 4)):
        ax.set_facecolor("#F7F7F7")

        top    = top_ngrams_by_k[k]
        labels = [" ".join(ng) for ng, _ in top][::-1]
        counts = [c for _, c in top][::-1]

        # Dégradé : de la couleur sombre (rang bas) à plus vive (rang haut)
        cmap_vals  = np.linspace(0.45, 1.0, len(counts))
        bar_colors = [tuple(base_rgb * v) for v in cmap_vals]

        bars = ax.barh(
            range(len(labels)), counts,
            color=bar_colors,
            edgecolor="none",
            height=0.65,
        )

        # Valeurs au bout des barres
        for bar, count in zip(bars, counts):
            ax.text(
                bar.get_width() + max(counts) * 0.01,
                bar.get_y() + bar.get_height() / 2,
                str(count),
                va="center", ha="left",
                color="#444444", fontsize=8.5,
                fontfamily="monospace"
            )

        ax.set_yticks(range(len(labels)))
        ax.set_yticklabels(labels, fontsize=9.5, color="#222222")
        ax.set_xlabel("Occurrences", color="#555555", fontsize=10)
        ax.set_title(
            k_labels[k],
            color=color, fontsize=13, fontweight="bold", pad=12
        )

        ax.tick_params(axis="x", colors="#555555")
        ax.tick_params(axis="y", colors="#222222")
        ax.spines["top"].set_visible(False)
        ax.spines["right"].set_visible(False)
        ax.spines["left"].set_color("#CCCCCC")
        ax.spines["bottom"].set_color("#CCCCCC")
        ax.set_xlim(0, max(counts) * 1.18)
        ax.xaxis.grid(True, color="#E0E0E0", linewidth=0.7, linestyle="--")
        ax.set_axisbelow(True)

    fig.suptitle(
        f"Top {TOP_N} k-uplets — {campaign}",
        color="#111111", fontsize=17, fontweight="bold", y=1.01
    )

    plt.tight_layout()
    slug     = campaign.lower().replace(" ", "_")
    out_path = os.path.join(OUTPUT_DIR, f"ngrams_{slug}.png")
    plt.savefig(out_path, dpi=150, bbox_inches="tight", facecolor="white")
    plt.show()
    print(f"  ✓ Plot sauvegardé → {out_path}")
    plt.close()


def process_campaign(campaign, filename):
    path = os.path.join(INPUT_DIR, filename)
    if not os.path.exists(path):
        print(f"  ⚠️  Fichier introuvable : {path}")
        return

    with open(path, encoding="utf-8") as f:
        rows = list(csv.DictReader(f))

    full_text = " ".join(
        row["text"] for row in rows
        if row.get("text", "").strip()
    )

    if not full_text:
        print(f"  ⚠️  Aucun texte pour {campaign}")
        return

    print(f"\n{'='*60}")
    print(f"  {campaign} — {len(rows)} articles — tokenisation...")
    print(f"{'='*60}")

    tokens = get_tokens(full_text)

    top_ngrams_by_k = {}
    for k in (2, 3, 4):
        ngrams          = list(extract_ngrams(tokens, k))
        counter         = Counter(ngrams)
        top_ngrams_by_k[k] = counter.most_common(TOP_N)

        print(f"\n  Top {TOP_N} {k}-uplets :")
        for rank, (ngram, count) in enumerate(top_ngrams_by_k[k], 1):
            print(f"    {rank:>2}. {' '.join(ngram):<40} ({count})")

    plot_campaign(campaign, top_ngrams_by_k, CAMPAIGN_COLORS[campaign])


def main():
    for campaign, filename in CAMPAIGN_FILES.items():
        process_campaign(campaign, filename)
    print("\n✓ Terminé.")


if __name__ == "__main__":
    main()
